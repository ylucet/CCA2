+function Q = zDivExact(Z, g)
+% Z / g EXACTLY, Z an integer polyN (doubles or bigZ), g a small integer polyN whose leading
+% coefficient in x (or else in y) is a constant: long division in that variable over Z[other],
+% every step an exact BigInteger division. [] when g does not divide Z.
+    Q = [];
+    if isnumeric(Z) && all(abs(Z(:)) < 2^53)
+        try
+            Q = ratQ.trimN(ratQ.polyDivExact(Z, g, 2));
+        catch
+            Q = [];
+        end
+        return
+    end
+    try
+        Q = zDivBig(Z, g);
+    catch
+        Q = [];
+    end
+end
+
+function Q = zDivBig(Z, g)
+    Q = [];
+    C = bigZ(Z);  C = C.c;
+    [d, ok] = leadConst(g);
+    tr = false;
+    if ~ok
+        [d, ok] = leadConst(g.');
+        if ~ok, return, end
+        g = g.';  C = C.';  tr = true;
+    end
+    [m, n] = size(C);  [~, ng] = size(g);
+    if m - 1 < d, return, end
+    W = n + ng - 1;
+    Z0 = java.math.BigInteger.ZERO;
+    R = repmat({Z0}, m, W);  R(:, 1:n) = C;
+    q = repmat({Z0}, m - d, n);
+    c = java.math.BigInteger.valueOf(int64(g(d+1, 1)));
+    G = cell(size(g));
+    for a = 1:numel(g), G{a} = java.math.BigInteger.valueOf(int64(g(a))); end
+    for i = m-1:-1:d
+        for jj = 1:W
+            if R{i+1, jj}.signum() == 0, continue, end
+            qr = R{i+1, jj}.divideAndRemainder(c);
+            if qr(2).signum() ~= 0, return, end
+            if jj > n, return, end
+            qv = qr(1);  q{i-d+1, jj} = qv;
+            for a = 0:d
+                for b = 0:ng-1
+                    if G{a+1, b+1}.signum() == 0, continue, end
+                    R{i-d+a+1, jj+b} = R{i-d+a+1, jj+b}.subtract(qv.multiply(G{a+1, b+1}));
+                end
+            end
+        end
+    end
+    if any(cellfun(@(x) x.signum() ~= 0, R(:))), return, end
+    Q = bigZ(q);
+    if tr, Q = Q.'; end
+    Q = zNorm(Q);
+end
+
+function [d, ok] = leadConst(g)
+% The degree in x of g and whether its leading coefficient (a polynomial in y) is a nonzero constant.
+    d = find(any(g ~= 0, 2), 1, 'last') - 1;
+    ok = ~isempty(d) && g(d+1, 1) ~= 0 && ~any(g(d+1, 2:end));
+end
