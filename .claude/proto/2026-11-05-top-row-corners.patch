+function [Z, ch] = zDivideOut(Z, factors)
+% divideOut for an exact polynomial, doubles or bigZ: each region factor (>= 0 on the region) out as
+% often as it divides exactly, up to 4 times -- the sign on the region is kept.
+    ch = false;
+    if isnumeric(Z)
+        Z2 = divideOut(Z, factors);  ch = ~isequal(Z2, Z);  Z = Z2;
+        return
+    end
+    if ~isa(Z, 'bigZ'), return, end
+    for k = 1:numel(factors)
+        g = intFactor(factors{k});
+        if isempty(g), continue, end
+        for it = 1:4
+            Z2 = zDivExact(Z, g);
+            if isempty(Z2), break, end
+            Z = Z2;  ch = true;
+        end
+    end
+end
+
+function g = intFactor(g)
+% A region factor as a content-free integer polyN, [] when it is constant or not dyadic.
+    for sc = 1:30
+        if all(g(:) == round(g(:))), break, end
+        g = 2 * g;
+    end
+    if numel(g) <= 1 || any(g(:) ~= round(g(:))), g = []; return, end
+    try
+        g = ratQ.contentFree(ratQ.trimN(g));
+    catch
+        g = []; return
+    end
+    if numel(g) <= 1, g = []; end
+end
+
+function tf = zAny(Z)
+    if isnumeric(Z), tf = any(Z(:)); return, end
+    tf = any(cellfun(@(c) c.signum() ~= 0, Z.c(:)));
+end
