diff --git a/rust/src/ptrace.rs b/rust/src/ptrace.rs
new file mode 100644
index 0000000..639a516
--- /dev/null
+++ b/rust/src/ptrace.rs
@@ -0,0 +1,104 @@
+//! Instrumentation for the parallelisation study (PARALLEL.md). NOT part of the engine: it lives in
+//! bench/parallel/span_instrumentation.patch and is applied only to repeat the measurement.
+//!
+//! Work / span accounting of a SERIAL run. A `Par` marks a region whose branches could run
+//! concurrently; each branch is timed. For a region with branches of wall time w_i and inner
+//! savings s_i, the span is max_i (w_i - s_i) and the saving is sum_i w_i - span. SAVED holds the
+//! running total, so T_inf = wall - SAVED at the end. CCA2_PT_CLASSES is a bit mask of the region
+//! classes that count (PARALLEL.md section 4): 1 independent loops, 2 alg_face_below fork-join,
+//! 4 box_rec fork-join, 8 / 64 drop_below loops 1 / 2, 16 corner loop, 32 bridge_witness samples.
+use std::cell::Cell;
+use std::sync::OnceLock;
+use std::time::Instant;
+
+pub fn classes() -> u32 {
+    static ON: OnceLock<u32> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("CCA2_PT_CLASSES").ok().and_then(|v| v.parse().ok()).unwrap_or(0))
+}
+
+thread_local! {
+    static SAVED: Cell<f64> = const { Cell::new(0.0) };
+    static NREG: Cell<[u64; 8]> = const { Cell::new([0; 8]) };
+}
+
+pub fn saved() -> f64 {
+    SAVED.with(|s| s.get())
+}
+pub fn reset() {
+    SAVED.with(|s| s.set(0.0));
+    NREG.with(|s| s.set([0; 8]));
+}
+pub fn regions() -> [u64; 8] {
+    NREG.with(|s| s.get())
+}
+
+pub fn cold() -> u32 {
+    static ON: OnceLock<u32> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("CCA2_PT_COLD").ok().and_then(|v| v.parse().ok()).unwrap_or(0))
+}
+
+/// Every memo of the engine emptied: a branch entered cold owes nothing to the branches before it.
+pub fn clear_all() {
+    crate::conic_meet::clear_memo();
+    crate::alg_row_fails::clear_all_memos();
+    crate::rat_q::clear_all_memos();
+    crate::envelope_subdivision_alg::clear_memos();
+}
+
+pub struct Par {
+    cold: bool,
+    on: bool,
+    sum: f64,
+    max: f64,
+}
+pub struct Branch<'a> {
+    par: &'a mut Par,
+    t0: Option<Instant>,
+    s0: f64,
+}
+impl Par {
+    #[inline]
+    pub fn new(class: u32) -> Par {
+        let on = classes() & class != 0;
+        if on {
+            NREG.with(|s| {
+                let mut a = s.get();
+                a[class.trailing_zeros() as usize] += 1;
+                s.set(a);
+            });
+        }
+        Par { cold: on && cold() & class != 0, on, sum: 0.0, max: 0.0 }
+    }
+    #[inline]
+    pub fn enter(&mut self) -> Branch<'_> {
+        if self.cold {
+            clear_all();
+        }
+        if self.on {
+            let s0 = saved();
+            Branch { par: self, t0: Some(Instant::now()), s0 }
+        } else {
+            Branch { par: self, t0: None, s0: 0.0 }
+        }
+    }
+}
+impl Drop for Branch<'_> {
+    #[inline]
+    fn drop(&mut self) {
+        if let Some(t0) = self.t0 {
+            let w = t0.elapsed().as_secs_f64();
+            let s = saved() - self.s0;
+            self.par.sum += w;
+            self.par.max = self.par.max.max(w - s);
+            SAVED.with(|c| c.set(self.s0));
+        }
+    }
+}
+impl Drop for Par {
+    #[inline]
+    fn drop(&mut self) {
+        if self.on && self.sum > self.max {
+            SAVED.with(|c| c.set(c.get() + self.sum - self.max));
+        }
+    }
+}
